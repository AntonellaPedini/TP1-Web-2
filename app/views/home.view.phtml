<?php
class HomeView {
    public function renderHome($obras, $imagenesCarrusel) {
        require_once __DIR__ . '/../../templates/layout/header.php';

        // Mezclar aleatoriamente y tomar solo 8 imágenes
        $imagenesAleatorias = $imagenesCarrusel;
        shuffle($imagenesAleatorias);
        $imagenesAleatorias = array_slice($imagenesAleatorias, 0, 8);
        ?>

        <!-- CARRUSEL BOOTSTRAP -->
        <div id="carruselObras" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">

            <div class="carousel-inner">
                <?php foreach ($imagenesAleatorias as $index => $obra): ?>
                    <div class="carousel-item <?= $index === 0 ? 'active' : '' ?>">
                        <img src="<?= htmlspecialchars($obra->imagen) ?>"
                            class="d-block w-100"
                            alt="<?= htmlspecialchars($obra->nombre) ?>"
                            style="height: 900px; object-fit: contain;">
                        <div class="carousel-caption d-none d-md-block">
                            <h5><?= htmlspecialchars($obra->nombre) ?></h5>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>

            <!-- Botones anterior/siguiente -->
            <button class="carousel-control-prev" type="button"
                    data-bs-target="#carruselObras" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button"
                    data-bs-target="#carruselObras" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>

        </div>

        <?php
        require_once __DIR__ . '/../../templates/layout/footer.php';
    }
}